# Local ROMs, saves, and game-derived archives: never commit user-owned data.
*.nds
*.narc
*.sav
*.dsv
*.cia
*.3ds
*.cci
*.zip
/roms/
/ROMs/
/local-data/
/.local-data/

# Runtime inputs for local packaging and user-generated save/config files.
# These may contain game-derived data and must never be committed or released.
/launcher-app/runtime/
/launcher-app/black-runtime/
/android-native-artifact/
save.bin
sim_config.ini
runtime-manifest.txt
launcher-runtime-version.txt

# Temporary Black validation checkout (pinned upstream source, generated C, and build outputs).
# Never commit the downloaded upstream trees or native build products.
.black-ci/

# Build outputs and Python cache.
build/
build_*/
vendor/pokeplatinum-native/build/
vendor/pokeplatinum-native/build_*/
__pycache__/
*.py[cod]
.pytest_cache/
# Runtime extraction writes into the process working directory. If a developer
# accidentally launches the native executable with the repository root as CWD,
# keep the ROM-derived output out of version control as well.
# (The normal location is build_linux/ or build_win64/, ignored above.)
/header.bin
/arm9.bin
/arm7.bin
/arm9ovt.bin
/arm7ovt.bin
/banner.bin
/fnt.bin
/fat.bin
/rsasig.bin
/overlay7/
/overlay9/
/battle/
/data/
/demo/
/dwc/
/fielddata/
/graphic/
/msgdata/
/poketool/
/pokemon/
/record/
/sound_data/
/trainer/
