+void ConfigureTouchOverlay(int width, int height,
+                           int safeLeft, int safeTop,
+                           int safeRight, int safeBottom) {
+    sTouchControls.Configure(width, height,
+        {safeLeft, safeTop, safeRight, safeBottom});
+}
+
+bool TouchOverlayHitTest(int x, int y) {
+#if defined(SDK_BUILD_ANDROID) || defined(SDK_BUILD_IOS)
+    return sTouchControls.Claims({x, y});
+#else
+    (void)x;
+    (void)y;
+    return false;
+#endif
+}
+
+void TouchOverlayBegin(bool finger, std::int64_t deviceId,
+                       std::int64_t pointerId, int x, int y) {
+    sTouchControls.Begin({
+        finger ? Platina::MobileInput::PointerSource::Finger
+               : Platina::MobileInput::PointerSource::Mouse,
+        deviceId,
+        pointerId,
+    }, {x, y});
+}
+
+void TouchOverlayMove(bool finger, std::int64_t deviceId,
+                      std::int64_t pointerId, int x, int y) {
+    sTouchControls.Move({
+        finger ? Platina::MobileInput::PointerSource::Finger
+               : Platina::MobileInput::PointerSource::Mouse,
+        deviceId,
+        pointerId,
+    }, {x, y});
+}
+
+void TouchOverlayEnd(bool finger, std::int64_t deviceId, std::int64_t pointerId) {
+    sTouchControls.End({
+        finger ? Platina::MobileInput::PointerSource::Finger
+               : Platina::MobileInput::PointerSource::Mouse,
+        deviceId,
+        pointerId,
+    });
+}
+
+void TouchOverlayCancelAll() {
+    sTouchControls.CancelAll();
+}
+
+std::uint16_t TouchOverlayPressedMask() {
+#if defined(SDK_BUILD_ANDROID) || defined(SDK_BUILD_IOS)
+    return sTouchControls.PressedMask();
+#else
+    return 0;
+#endif
+}
