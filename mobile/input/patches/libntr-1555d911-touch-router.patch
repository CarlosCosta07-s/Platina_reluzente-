 extern OSThreadInfo OSi_ThreadInfo;
 
 static u32 s_TouchPanelCoords[4] = {}; // The bounding box of the touch screen
 
+static Platina::MobileInput::TouchInputRouter s_TouchInputRouter;
+static Platina::MobileInput::VirtualTouchControls s_TouchControls;
+
+static Platina::MobileInput::TouchPanel SIM_GetTouchPanel() {
+  return {
+      {
+          static_cast<int>(s_TouchPanelCoords[0]),
+          static_cast<int>(s_TouchPanelCoords[1]),
+          static_cast<int>(s_TouchPanelCoords[2]),
+          static_cast<int>(s_TouchPanelCoords[3]),
+      },
+      SIM_NDS_SCREEN_WIDTH,
+      SIM_NDS_SCREEN_HEIGHT,
+  };
+}
+
+static bool SIM_TouchOverlayClaims(
+    const Platina::MobileInput::Point &position) {
+  // The virtual-control overlay is a separate implementation step. Keep this
+  // hit-test hook ahead of DS routing so the overlay can claim a pointer later.
+  (void)position;
+#if defined(SDK_BUILD_ANDROID) || defined(SDK_BUILD_IOS)
+  return s_TouchControls.Claims(position);
+#else
+  (void)position;
+  return false;
+#endif
+}
+
+static int SIM_NormalizedTouchCoordinate(float normalized, int dimension) {
+  if (dimension <= 1) {
+    return 0;
+  }
+
+  int coordinate = static_cast<int>(normalized * static_cast<float>(dimension));
+  if (coordinate < 0) {
+    coordinate = 0;
+  } else if (coordinate >= dimension) {
+    coordinate = dimension - 1;
+  }
+  return coordinate;
+}
+
+static void SIM_ApplyTouchUpdate(
+    const Platina::MobileInput::TouchUpdate &update) {
+  if (update.target != Platina::MobileInput::TouchTarget::DsStylus) {
+    return;
+  }
+
+  if (update.ended || !update.dsTouchActive) {
+    s_tpData.validity = 0;
+    s_tpData.touch = 0;
+    return;
+  }
+
+  if (!s_tpData.touch) {
+    s_tpData.validity = 0;
+  }
+  s_tpData.x = static_cast<u16>(update.dsX);
+  s_tpData.y = static_cast<u16>(update.dsY);
+  s_tpData.touch = 1;
+}
+
+static void SIM_CancelTouchInput() {
+  const auto cancelled = s_TouchInputRouter.CancelAll(SIM_GetTouchPanel());
+  // Cancel all overlay pointers on the same lifecycle boundary as the DS stylus.
+  (void)cancelled;
+  s_TouchControls.CancelAll();
+  s_tpData.validity = 0;
+  s_tpData.touch = 0;
+}
+
+static ImVec2 SIM_TouchToImVec2(
+    const Platina::MobileInput::Point &point) {
+  return ImVec2(static_cast<float>(point.x), static_cast<float>(point.y));
+}
+
+static void SIM_DrawTouchLabel(ImDrawList *drawList, const ImVec2 &center,
+                               const char *label, ImU32 color) {
+  const ImVec2 textSize = ImGui::CalcTextSize(label);
+  drawList->AddText(
+      ImVec2(center.x - textSize.x * 0.5f, center.y - textSize.y * 0.5f),
+      color, label);
+}
+
+static void SIM_DrawTouchDirection(ImDrawList *drawList,
+                                   const ImVec2 &center, float radius,
+                                   const char *label, bool pressed) {
+  const ImU32 fill = pressed ? IM_COL32(55, 155, 235, 205)
+                             : IM_COL32(18, 25, 38, 155);
+  drawList->AddCircleFilled(center, radius, fill, 20);
+  drawList->AddCircle(center, radius, IM_COL32(220, 235, 250, 145), 20, 1.5f);
+  SIM_DrawTouchLabel(drawList, center, label, IM_COL32(255, 255, 255, 235));
+}
+
+static void SIM_DrawMobileTouchOverlay() {
+#if defined(SDK_BUILD_ANDROID) || defined(SDK_BUILD_IOS)
+  if (!s_TouchControls.IsConfigured()) {
+    return;
+  }
+  const auto visuals = s_TouchControls.Visuals();
+  ImDrawList *drawList = ImGui::GetForegroundDrawList();
+  const auto &dpad = visuals[0];
+  const ImVec2 dpadCenter = SIM_TouchToImVec2(dpad.center);
+  drawList->AddCircleFilled(dpadCenter, dpad.radius,
+                            IM_COL32(12, 18, 30, 112), 40);
+  drawList->AddCircle(dpadCenter, dpad.radius,
+                      IM_COL32(225, 235, 248, 145), 40, 2.0f);
+  const auto pressed = s_TouchControls.PressedMask();
+  const float offset = dpad.radius * 0.53f;
+  const float directionRadius = dpad.radius * 0.29f;
+  SIM_DrawTouchDirection(drawList,
+      ImVec2(dpadCenter.x, dpadCenter.y - offset), directionRadius, "U",
+      (pressed & Platina::MobileInput::VirtualButtonUp) != 0);
+  SIM_DrawTouchDirection(drawList,
+      ImVec2(dpadCenter.x, dpadCenter.y + offset), directionRadius, "D",
+      (pressed & Platina::MobileInput::VirtualButtonDown) != 0);
+  SIM_DrawTouchDirection(drawList,
+      ImVec2(dpadCenter.x - offset, dpadCenter.y), directionRadius, "L",
+      (pressed & Platina::MobileInput::VirtualButtonLeft) != 0);
+  SIM_DrawTouchDirection(drawList,
+      ImVec2(dpadCenter.x + offset, dpadCenter.y), directionRadius, "R",
+      (pressed & Platina::MobileInput::VirtualButtonRight) != 0);
+  for (std::size_t index = 1; index < visuals.size(); ++index) {
+    const auto &button = visuals[index];
+    const ImVec2 center = SIM_TouchToImVec2(button.center);
+    const ImU32 fill = button.pressed
+        ? IM_COL32(45, 145, 225, 205)
+        : IM_COL32(18, 25, 38, 145);
+    drawList->AddCircleFilled(center, button.radius, fill, 32);
+    drawList->AddCircle(center, button.radius,
+                        IM_COL32(225, 235, 248, 160), 32, 1.5f);
+    SIM_DrawTouchLabel(drawList, center, button.label,
+                       IM_COL32(255, 255, 255, 238));
+  }
+#endif
+}
