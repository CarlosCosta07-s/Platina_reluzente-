 extern OSThreadInfo OSi_ThreadInfo;
 
 static u32 s_TouchPanelCoords[4] = {}; // The bounding box of the touch screen
+static Platina::MobileInput::TouchInputRouter s_TouchInputRouter;
+
+static Platina::MobileInput::TouchPanel SIM_GetTouchPanel() {
+  return {
+      {
+          static_cast<int>(s_TouchPanelCoords[0]),
+          static_cast<int>(s_TouchPanelCoords[1]),
+          static_cast<int>(s_TouchPanelCoords[2]),
+          static_cast<int>(s_TouchPanelCoords[3]),
+      },
+      SIM_NDS_SCREEN_WIDTH,
+      SIM_NDS_SCREEN_HEIGHT,
+  };
+}
+
+static bool SIM_TouchOverlayClaims(
+    const Platina::MobileInput::Point &position) {
+  // The virtual-control overlay is a separate implementation step. Keep this
+  // hit-test hook ahead of DS routing so the overlay can claim a pointer later.
+  (void)position;
+  return false;
+}
+
+static int SIM_NormalizedTouchCoordinate(float normalized, int dimension) {
+  if (dimension <= 1) {
+    return 0;
+  }
+
+  int coordinate = static_cast<int>(normalized * static_cast<float>(dimension));
+  if (coordinate < 0) {
+    coordinate = 0;
+  } else if (coordinate >= dimension) {
+    coordinate = dimension - 1;
+  }
+  return coordinate;
+}
+
+static void SIM_ApplyTouchUpdate(
+    const Platina::MobileInput::TouchUpdate &update) {
+  if (update.target != Platina::MobileInput::TouchTarget::DsStylus) {
+    return;
+  }
+
+  if (update.ended || !update.dsTouchActive) {
+    s_tpData.validity = 0;
+    s_tpData.touch = 0;
+    return;
+  }
+
+  if (!s_tpData.touch) {
+    s_tpData.validity = 0;
+  }
+  s_tpData.x = static_cast<u16>(update.dsX);
+  s_tpData.y = static_cast<u16>(update.dsY);
+  s_tpData.touch = 1;
+}
+
+static void SIM_CancelTouchInput() {
+  const auto cancelled = s_TouchInputRouter.CancelAll(SIM_GetTouchPanel());
+  // The overlay will consume per-pointer cancellation notifications when it
+  // is connected. The native DS touch state must be released immediately.
+  (void)cancelled;
+  s_tpData.validity = 0;
+  s_tpData.touch = 0;
+}
 
